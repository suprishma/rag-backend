# ── Application ──────────────────────────────────────────────
APP_ENV=development          # development or production
APP_HOST=0.0.0.0             # server host
APP_PORT=8000                # server port
LOG_LEVEL=INFO               # logging level

# ── OpenAI ───────────────────────────────────────────────────
OPENAI_API_KEY=sk-...                    # your OpenAI key (or "ollama")
OPENAI_EMBEDDING_MODEL=nomic-embed-text  # embedding model
OPENAI_CHAT_MODEL=llama3.2              # chat model
OPENAI_EMBEDDING_DIMENSIONS=768         # nomic=768, openai=1536

# ── Qdrant ───────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333         # vector database URL
QDRANT_API_KEY=                          # leave blank for local
QDRANT_COLLECTION_NAME=documents         # collection name

# ── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0       # chat memory
REDIS_CHAT_TTL_SECONDS=86400            # history expires in 24h

# ── PostgreSQL ───────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://rag:rag@localhost:5432/rag_db

# ── Chunking defaults ────────────────────────────────────────
CHUNK_SIZE=512                           # words per chunk
CHUNK_OVERLAP=64                         # overlap between chunks
SEMANTIC_SIMILARITY_THRESHOLD=0.85      # for semantic chunking

# ── RAG ──────────────────────────────────────────────────────
RAG_TOP_K=5                             # number of chunks to retrieve
RAG_SCORE_THRESHOLD=0.30                # minimum similarity score
